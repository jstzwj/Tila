# examples/batched_add.tila — 符号维 + 二维 tiling + 坐标寻址（v0.3 strides 版）
#
# M = batch 维，N = 特征维：运行时变量，由 launcher 从张量形状读取传入。
# v0.3：寻址用一级坐标原语 tila.load(a, (rows2, cols2))，行主序线性化
# （rows2 * N + cols2）由编译器发射——kernel 里不再有任何手工线性化（docs/v0.3-strides.md §1.2）。
# 设计要点：变量在 shape 与 mask，不在分布 —— 见 docs/v0.2-preview-2d.md §1。

import tila


@tila.jit
def batched_add(
    a: tila.Tensor[tila.float32, M, N],   # M、N 首次出现，自动绑定为符号参数
    b: tila.Tensor[tila.float32, M, N],
    c: tila.Tensor[tila.float32, M, N],
    BM: tila.constexpr = 64,
    BN: tila.constexpr = 128,
):
    pid_m = tila.program_id(0)                    # : Scalar(i32)     —— 2D grid 第 0 轴
    pid_n = tila.program_id(1)                    # : Scalar(i32)     —— 第 1 轴

    rows = pid_m * BM + tila.arange(0, BM)        # : Tile[i32, (64,),   L0 = identity(64)]
    cols = pid_n * BN + tila.arange(0, BN)        # : Tile[i32, (128,),  L1 = identity(128)]

    rows2 = tila.expand_dim(rows, 1)              # : Tile[i32, (64,1),  L0]   —— E14 禁重绑定，用新名
    cols2 = tila.expand_dim(cols, 0)              # : Tile[i32, (1,128), L1]

    mask = (rows2 < M) & (cols2 < N)              # : Tile[bool, (64,128), L2 = product(L0,L1)]

    x = tila.load(a, (rows2, cols2), mask=mask)  # : Tile[f32, (64,128), L2]
    y = tila.load(b, (rows2, cols2), mask=mask)  # : Tile[f32, (64,128), L2]

    z = x + y                                     # : Tile[f32, (64,128), L2]

    tila.store(c, (rows2, cols2), z, mask=mask)  # : ()


# 启动（launcher 从 a.shape 读取 M、N；grid 为二维）：
#
#     batched_add_launch(a, b, c, BM=64, BN=128)
#
# 等价于（Triton 式启动表达式）：
#
#     grid = (triton.cdiv(M, BM), triton.cdiv(N, BN))
#     batched_add[grid](a, b, c, M, N, BM=64, BN=128)
