# examples/saxpy.tila — out = alpha * x + y（v0.1 验收程序集）
#
# alpha 是未注解参数 → Scalar(i32)（language-spec.md §4）。
# 标量值域只有 i32/f32：浮点标量必须经显式 cast 产生（R11）——
# 这正是"无隐式转换"在标量侧的体现。

import tila


@tila.jit
def saxpy(
    x: tila.Tensor[tila.float32, N],
    y: tila.Tensor[tila.float32, N],
    out: tila.Tensor[tila.float32, N],
    alpha,                                # Scalar(i32)（运行期标量）
    BLOCK: tila.constexpr = 128,
):
    pid = tila.program_id(0)                     # : Scalar(i32)

    offs = pid * BLOCK + tila.arange(0, BLOCK)   # : Tile[i32, (128,), L0]
    mask = offs < N                              # : Tile[bool, (128,), L0]

    xv = tila.load(x, (offs,), mask=mask)          # : Tile[f32, (128,), L0]
    yv = tila.load(y, (offs,), mask=mask)          # : Tile[f32, (128,), L0]

    a = tila.cast(alpha, tila.float32)           # : Scalar(f32)   （R11）
    t = xv * a                                   # : Tile[f32, (128,), L0]   （R4，标量广播）
    z = t + yv                                   # : Tile[f32, (128,), L0]   （R5）

    tila.store(out, (offs,), z, mask=mask)         # : ()


# 启动（由生成的 launcher 完成，N 从 x 的形状自动读取）：
#
#     saxpy_launch(x, y, out, alpha, BLOCK=128)
