# examples/matmul.tila — matmul fragment（v0.2 片段二，docs/v0.2-matmul-fragment.md）
#
# 单发 tila.dot：K 维整体装进一个 BK 块（正确性包络 K <= BK，masked 补零）。
# dot 是第一个"外来"布局的构造点：结果驻留 Mma(BM,BN,BK) 分布（MMA 指令
# 规定，不从 arange 推导）；store 侧按 R9' 的坐标语义直接写回 blocked 索引。
# 完整 K 归约需要 K 循环（v0.2 主线）。

import tila


@tila.jit
def matmul(
    a: tila.Tensor[tila.float16, M, K],
    b: tila.Tensor[tila.float16, K, N],
    c: tila.Tensor[tila.float32, M, N],
    BM: tila.constexpr = 64,
    BN: tila.constexpr = 128,
    BK: tila.constexpr = 64,
):
    pid_m = tila.program_id(0)                    # : Scalar(i32)
    pid_n = tila.program_id(1)                    # : Scalar(i32)

    rm = pid_m * BM + tila.arange(0, BM)          # : Tile[i32, (64,),   L0]
    rn = pid_n * BN + tila.arange(0, BN)          # : Tile[i32, (128,),  L1]
    rk = tila.arange(0, BK)                       # : Tile[i32, (64,),   L2]

    rm2 = tila.expand_dim(rm, 1)                  # : Tile<i32, (64,1),  L0>
    rk2 = tila.expand_dim(rk, 0)                  # : Tile<i32, (1,64),  L0]
    rk3 = tila.expand_dim(rk, 1)                  # : Tile<i32, (64,1),  L0]
    rn2 = tila.expand_dim(rn, 0)                  # : Tile[i32, (1,128), L1]

    a_idx = rm2 * K + rk2                         # : Tile[i32, (64,64),  product(L0,L0)>
    b_idx = rk3 * N + rn2                         # : Tile<i32, (64,128), product(L0,L1)>
    c_idx = rm2 * N + rn2                         # : Tile<i32, (64,128), product(L0,L1)>

    a_m = (rm2 < M) & (rk2 < K)                   # : Tile[bool, (64,64)]
    b_m = (rk3 < K) & (rn2 < N)                   # : Tile[bool, (64,128)]
    c_m = (rm2 < M) & (rn2 < N)                   # : Tile[bool, (64,128)]

    x = tila.load(a + a_idx, mask=a_m, other=0.0)   # : Tile<f16, (64,64)>
    y = tila.load(b + b_idx, mask=b_m, other=0.0)   # : Tile<f16, (64,128)>

    acc = tila.dot(x, y)                          # : Tile[f32, (64,128), Mma(64,128,64)>

    tila.store(c + c_idx, acc, mask=c_m)          # : ()   R9'：内存边界布局无关


# 启动（launcher 从 a.shape 读 M、K，从 b.shape 读 N；grid 为二维）：
#
#     matmul_launch(a, b, c, BM=64, BN=128, BK=64)
