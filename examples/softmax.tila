import tila


@tila.jit
def softmax(
    a: tila.Tensor[tila.float16, M, N],
    o: tila.Tensor[tila.float16, M, N],
    BM: tila.constexpr = 64,
    BN: tila.constexpr = 128,
):
    pid = tila.program_id(0)
    rm2 = tila.expand_dim(pid * BM + tila.arange(0, BM), 1)
    rn2 = tila.expand_dim(tila.arange(0, BN), 0)
    m2 = (rm2 < M) & (rn2 < N)

    x = tila.cast(tila.load(a, (rm2, rn2), mask=m2), tila.float32)
    neg = tila.where(m2, x, tila.neg_inf)
    mx = tila.max(neg, axis=1)
    mx2 = tila.expand_dim(mx, 1)
    e = tila.where(m2, tila.exp(x - mx2), 0.0)
    s = tila.sum(e, axis=1)
    s2 = tila.expand_dim(s, 1)
    y = tila.where(m2, e / s2, 0.0)
    tila.store(o, (rm2, rn2), tila.cast(y, tila.float16), mask=m2)
