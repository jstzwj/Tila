# examples/masked_add.tila — masked load 的 other 语义（v0.1 验收程序集）
#
# other 给出时 masked-out 通道的值为 other（semantic-model.md §3）；
# other 必须与 mask 同时给出（E13），且字面量类别与元素 dtype 匹配（R12）。

import tila


@tila.jit
def masked_add(
    a: tila.Tensor[tila.float32, N],
    b: tila.Tensor[tila.float32, N],
    c: tila.Tensor[tila.float32, N],
    BLOCK: tila.constexpr = 128,
):
    pid = tila.program_id(0)                     # : Scalar(i32)

    offs = pid * BLOCK + tila.arange(0, BLOCK)   # : Tile[i32, (128,), L0]
    mask = offs < N                              # : Tile[bool, (128,), L0]

    x = tila.load(a, (offs,), mask=mask, other=0.0)   # : Tile[f32, (128,), L0]
    y = tila.load(b, (offs,), mask=mask, other=0.0)   # : Tile[f32, (128,), L0]

    z = x + y                                    # : Tile[f32, (128,), L0]

    tila.store(c, (offs,), z, mask=mask)           # : ()
